# deploy-ops 配置模板
# 用法：cp .env.example .env  然后填真实值。
# .env 已在 .gitignore 中，永远不会被提交。

# ── SSH（GitHub Actions 里用同名环境变量覆盖） ───────────────────────────────
DEPLOY_HOST=8.140.27.125
DEPLOY_USER=root
DEPLOY_PORT=22
# 私钥路径，相对本 skill 目录
SSH_KEY_PATH=.ssh/id_ed25519

# ── 服务器布局 ───────────────────────────────────────────────────────────────
APP_DIR=/var/www/pdm-ai-web-startup
WEB_PORT=3001
API_PORT=3101
PM2_WEB=pdm-web
PM2_API=pdm-api
BUN_BIN=/usr/local/bin/bun

# ── 入口 ─────────────────────────────────────────────────────────────────────
DOMAIN=ai.koiism.cn
PUBLIC_ORIGIN=https://ai.koiism.cn
TUNNEL_PORT=15432

# ── 数据库（服务器本机 PostgreSQL，不对外开端口） ───────────────────────────
DB_NAME=pdm_ai_platform
DB_USER=pdm_app
DB_PASSWORD=change-me
DATABASE_URL=postgresql://pdm_app:change-me@127.0.0.1:5432/pdm_ai_platform

# ── LLM（OpenAI 兼容） ───────────────────────────────────────────────────────
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=deepseek-flash
