{
  "name": "@xs/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts",
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist --packages external --sourcemap",
    "start": "NODE_ENV=production bun dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun src/db/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "1.0.63",
    "@elysiajs/cors": "^1.4.3",
    "@elysiajs/openapi": "^1.4.17",
    "@xs/shared": "workspace:*",
    "ai": "5.0.289",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.32"
  },
  "devDependencies": {
    "@types/bun": "^1.2.19",
    "drizzle-kit": "^0.31.11",
    "typescript": "5.9.3",
    "postgres": "^4.1.1"
  }
}
